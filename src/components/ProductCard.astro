---
/**
 * ProductCard — a product as a CellGrid cell, with a split action row:
 *
 *   [ media ]
 *   PRINTS                       from $45
 *   Event Horizon — Giclée print
 *   ──────────────────────────┬────
 *   [+] ADD TO CART           │  →
 *
 * Works in both grid looks (collapsed hairlines or boxed cells) because the
 * lines come from CellGrid and the action row draws only internal rules.
 */
import type { ImageMetadata } from 'astro';
import MediaFrame from './MediaFrame.astro';
import Arrow from './Arrow.astro';
import Price from './Price.astro';
import type { LocaleCode } from '../site.config';
import type { Category } from '../data/store';
import { useTranslations } from '../i18n/utils';

interface Props {
  slug: string;
  href: string;
  title: string;
  category: Category;
  price: number;
  fromPrice?: boolean;
  variant?: string;
  digital?: boolean;
  image: ImageMetadata;
  alt: string;
  locale: LocaleCode;
  priority?: boolean;
  sizes?: string;
}

const {
  slug,
  href,
  title,
  category,
  price,
  fromPrice = false,
  variant = '',
  digital = false,
  image,
  alt,
  locale,
  priority = false,
  sizes = '(min-width: 64rem) 33vw, (min-width: 40rem) 50vw, 100vw',
} = Astro.props;
const t = useTranslations(locale);
---

<li class="product-card" data-filter-item data-filter-key={category} data-flip-item>
  <a class="product-card__link" href={href} data-cursor="view">
    <MediaFrame src={image} alt={alt} ratio="portrait" sizes={sizes} priority={priority} />
    <div class="product-card__meta">
      <span class="t-label u-muted">{t.store.categories[category]}{digital && ` · ${t.store.digital}`}</span>
      <Price value={price} from={fromPrice} locale={locale} />
    </div>
    <h3 class="product-card__title">{title}</h3>
  </a>
  <div class="product-card__actions">
    <button
      type="button"
      class="product-card__add t-label"
      data-add-to-cart
      data-product={slug}
      data-variant={variant}
      data-label-added={t.store.added}
    >
      <bdi lang="en" aria-hidden="true">[+]</bdi>
      <span data-add-label>{t.store.addToCart}</span>
      <span class="visually-hidden">— {title}</span>
    </button>
    <a class="product-card__go" href={href} aria-label={`${t.store.view}: ${title}`}>
      <Arrow />
    </a>
  </div>
</li>

<style>
  @layer components {
    .product-card {
      display: flex;
      flex-direction: column;
    }

    .product-card__link {
      flex: 1;
      display: grid;
      align-content: start;
      gap: var(--space-sm);
      padding: var(--cell-pad);
      color: inherit;
      text-decoration: none;
      transition: background-color var(--dur-fast) var(--ease-standard);
    }

    .product-card__link:hover {
      background: var(--color-surface);
    }

    .product-card__link:focus-visible,
    .product-card__add:focus-visible,
    .product-card__go:focus-visible {
      outline-offset: calc(-2 * var(--line-width-strong));
    }

    .product-card__meta {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: var(--space-sm);
      padding-block-start: var(--space-2xs);
    }

    .product-card__title {
      font-size: var(--text-md);
      line-height: var(--leading-snug);
    }

    .product-card__actions {
      display: grid;
      grid-template-columns: minmax(0, 1fr) var(--button-height);
      border-block-start: var(--line-width) solid var(--color-line);
    }

    .product-card__add,
    .product-card__go {
      display: inline-flex;
      align-items: center;
      gap: var(--space-xs);
      min-block-size: var(--button-height);
      padding-inline: var(--cell-pad);
      color: var(--color-ink);
      text-decoration: none;
      transition:
        background-color var(--dur-fast) var(--ease-standard),
        color var(--dur-fast) var(--ease-standard);
    }

    .product-card__go {
      justify-content: center;
      padding-inline: 0;
      border-inline-start: var(--line-width) solid var(--color-line);
    }

    .product-card__add:hover,
    .product-card__go:hover {
      background: var(--color-ink);
      color: var(--color-canvas);
    }

    .product-card__add[data-added] {
      color: var(--color-accent-ink);
    }
  }
</style>
