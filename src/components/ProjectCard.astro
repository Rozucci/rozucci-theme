---
/**
 * ProjectCard — one project as a CellGrid cell. The whole cell is the link.
 *
 *   (03)  INDEX OF NIGHTS            WEB · 2025
 *   [ media 4:5 ]
 *
 * `data-discipline` is used by the work index filter; `data-cursor="view"`
 * shows the desktop cursor label.
 */
import type { ImageMetadata } from 'astro';
import MediaFrame from './MediaFrame.astro';
import Arrow from './Arrow.astro';
import type { LocaleCode } from '../site.config';
import type { Discipline } from '../data/disciplines';
import { code, useTranslations, year as fmtYear } from '../i18n/utils';

interface Props {
  href: string;
  title: string;
  summary?: string;
  discipline: Discipline;
  year: number;
  index: number;
  cover: ImageMetadata;
  coverAlt: string;
  locale: LocaleCode;
  priority?: boolean;
  as?: 'article' | 'li';
  sizes?: string;
}

const {
  href,
  title,
  summary,
  discipline,
  year,
  index,
  cover,
  coverAlt,
  locale,
  priority = false,
  as: Tag = 'li',
  sizes = '(min-width: 64rem) 33vw, (min-width: 40rem) 50vw, 100vw',
} = Astro.props;
const t = useTranslations(locale);
---

<Tag class="project-card" data-discipline={discipline} data-flip-item>
  <a class="project-card__link" href={href} data-cursor="view">
    <div class="project-card__meta">
      <span class="t-label u-muted"><bdi lang="en">({code(index)})</bdi></span>
      <span class="t-label u-muted project-card__tags">
        {t.disciplines[discipline].name} · {fmtYear(year, locale)}
      </span>
    </div>
    <MediaFrame
      src={cover}
      alt={coverAlt}
      ratio="portrait"
      sizes={sizes}
      priority={priority}
      parallax
      class="project-card__media"
    />
    <div class="project-card__foot">
      <h3 class="project-card__title">{title}</h3>
      <Arrow class="project-card__arrow" />
    </div>
    {summary && <p class="project-card__summary u-muted">{summary}</p>}
  </a>
</Tag>

<style>
  @layer components {
    .project-card__link {
      display: grid;
      gap: var(--space-sm);
      block-size: 100%;
      padding: var(--cell-pad);
      color: inherit;
      text-decoration: none;
      transition: background-color var(--dur-fast) var(--ease-standard);
    }

    .project-card__link:hover {
      background: var(--color-surface);
    }

    /* The grid clips overflow, so the focus ring sits inside the cell. */
    .project-card__link:focus-visible {
      outline-offset: calc(-2 * var(--line-width-strong));
    }

    .project-card__meta {
      display: flex;
      justify-content: space-between;
      gap: var(--space-sm);
    }

    .project-card__foot {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: var(--space-sm);
    }

    .project-card__title {
      font-size: var(--text-lg);
      line-height: var(--leading-snug);
    }

    .project-card__summary {
      font-size: var(--text-sm);
      line-height: var(--leading-snug);
    }

    .project-card__link :global(.project-card__arrow) {
      transition: translate var(--dur-fast) var(--ease-standard);
    }

    .project-card__link:hover :global(.project-card__arrow) {
      translate: calc(var(--dir-sign) * var(--motion-nudge)) 0;
    }
  }
</style>
