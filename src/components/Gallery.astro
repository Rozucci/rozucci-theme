---
/**
 * Gallery — product images as a native scroll-snap strip (touch and keyboard
 * friendly, no scroll-jacking). Text-sign prev/next and a Latin counter are
 * added with JS; without JS the strip simply scrolls.
 */
import type { ImageMetadata } from 'astro';
import MediaFrame from './MediaFrame.astro';

interface Props {
  images: { src: ImageMetadata; alt: string }[];
  label: string;
  prev: string;
  next: string;
}

const { images, label, prev, next } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<div class="gallery" data-gallery>
  <div class="gallery__track" role="region" aria-label={label} tabindex="0" data-gallery-track>
    {
      images.map((img, i) => (
        <div class="gallery__slide" data-gallery-slide>
          <MediaFrame
            src={img.src}
            alt={img.alt}
            ratio="portrait"
            priority={i === 0}
            reveal={i === 0}
            sizes="(min-width: 64rem) 50vw, 100vw"
            widths={[480, 800, 1200, 1600]}
          />
        </div>
      ))
    }
  </div>
  {
    images.length > 1 && (
      <div class="gallery__controls u-js-only">
        <button type="button" class="gallery__btn t-label" data-gallery-step="-1" aria-label={prev}>
          <span class="gallery__arrow" aria-hidden="true">‹</span>
        </button>
        <bdi lang="en" class="t-label u-muted" data-gallery-count aria-live="polite">
          01 / {pad(images.length)}
        </bdi>
        <button type="button" class="gallery__btn t-label" data-gallery-step="1" aria-label={next}>
          <span class="gallery__arrow" aria-hidden="true">›</span>
        </button>
      </div>
    )
  }
</div>

<style>
  @layer components {
    .gallery {
      display: grid;
      gap: var(--space-sm);
    }

    .gallery__track {
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: 100%;
      overflow-x: auto;
      scroll-snap-type: inline mandatory;
      scrollbar-width: none;
      overscroll-behavior-inline: contain;
    }

    .gallery__track::-webkit-scrollbar {
      display: none;
    }

    .gallery__track:focus-visible {
      outline-offset: calc(-1 * var(--line-width-strong));
    }

    .gallery__slide {
      scroll-snap-align: start;
    }

    .gallery__controls {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .gallery__btn {
      display: inline-grid;
      place-items: center;
      min-inline-size: var(--hit-target);
      min-block-size: var(--hit-target);
      font-size: var(--text-md);
      color: var(--color-ink);
    }

    .gallery__btn:disabled {
      color: var(--color-ink-subtle);
      cursor: default;
    }

    .gallery__arrow:dir(rtl) {
      display: inline-block;
      transform: scaleX(-1);
    }
  }
</style>

<script>
  import { onPageLoad } from '../scripts/lifecycle';

  onPageLoad(() => {
    document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
      const track = root.querySelector<HTMLElement>('[data-gallery-track]');
      const slides = [...root.querySelectorAll<HTMLElement>('[data-gallery-slide]')];
      const count = root.querySelector<HTMLElement>('[data-gallery-count]');
      const [prev, next] = [...root.querySelectorAll<HTMLButtonElement>('[data-gallery-step]')];
      if (!track || slides.length < 2) return;
      const pad = (n: number) => String(n).padStart(2, '0');
      let index = 0;

      const render = () => {
        if (count) count.textContent = `${pad(index + 1)} / ${pad(slides.length)}`;
        if (prev) prev.disabled = index === 0;
        if (next) next.disabled = index === slides.length - 1;
      };

      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting && e.intersectionRatio > 0.6) {
              index = slides.indexOf(e.target as HTMLElement);
              render();
            }
          });
        },
        { root: track, threshold: [0.6] },
      );
      slides.forEach((s) => io.observe(s));

      root.addEventListener('click', (e) => {
        const btn = (e.target as Element).closest<HTMLButtonElement>('[data-gallery-step]');
        if (!btn) return;
        const target = Math.max(0, Math.min(slides.length - 1, index + Number(btn.dataset.galleryStep)));
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        slides[target]!.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'nearest', inline: 'start' });
      });

      document.addEventListener('astro:before-swap', () => io.disconnect(), { once: true });
      render();
    });
  });
</script>
