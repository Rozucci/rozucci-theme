---
/**
 * NotchCard — the signature component, and the only rounded element
 * (--radius-card).
 *
 *   ╭────────────────────╮
 *   │  [ media ]         │
 *   │                    │
 *  ◖                      ◗   ← pill notches cut through to the ground
 *   │ [ LABEL ]    02:40 │
 *   │ ───────●────────── │   ← hairline timeline, one dot (progress)
 *   │ Description text   │
 *   │ [+] VIEW           │
 *   ╰────────────────────╯
 *
 * The notches are cut with a CSS mask (full layer minus four shapes), so the
 * area around them is truly transparent on any background. Their size and
 * position come from tokens: --notch-w, --notch-h, --notch-gap and
 * --notch-media-ratio (the notch centre sits --notch-gap below the media).
 * Container query units make the position exact at any card width.
 * Notches are symmetric; label/meta and the timeline mirror in RTL through
 * logical properties.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  label: string;
  meta?: string;
  title?: string;
  description?: string;
  href?: string;
  action?: string;
  sign?: string;
  /** 0…1 — position of the dot on the timeline. */
  progress?: number;
  src?: ImageMetadata;
  alt?: string;
  /** Media height ÷ width. Overrides --notch-media-ratio for this card. */
  mediaRatio?: number;
  level?: 'h2' | 'h3' | 'h4';
  /** Latin meta (time, code) stays LTR and mono. */
  metaIsCode?: boolean;
  class?: string;
  sizes?: string;
}

const {
  label,
  meta,
  title,
  description,
  href,
  action,
  sign = '[+]',
  progress = 0,
  src,
  alt = '',
  mediaRatio,
  level: Heading = 'h3',
  metaIsCode = true,
  class: className,
  sizes = '(min-width: 64rem) 25vw, (min-width: 40rem) 45vw, 80vw',
} = Astro.props;

const p = Math.min(1, Math.max(0, progress));
const style = [`--notch-progress: ${p}`, mediaRatio ? `--notch-media-ratio: ${mediaRatio}` : '']
  .filter(Boolean)
  .join('; ');
const hasMediaSlot = Astro.slots.has('media');
---

<article class:list={['notch', className]} style={style} data-reveal="up">
  <div class="notch__card">
    <div class="notch__media">
      {
        src ? (
          <Picture
            src={src}
            alt={alt}
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            widths={[400, 640, 960].filter((w) => w <= src.width)}
            sizes={sizes}
            loading="lazy"
            class="notch__img"
          />
        ) : (
          hasMediaSlot && <slot name="media" />
        )
      }
    </div>

    <div class="notch__body">
      <div class="notch__row t-label">
        <span class="notch__label">
          <span aria-hidden="true">[&nbsp;</span>{label}<span aria-hidden="true">&nbsp;]</span>
        </span>
        {meta && (metaIsCode ? <bdi lang="en" class="notch__meta">{meta}</bdi> : <span class="notch__meta">{meta}</span>)}
      </div>

      <div class="notch__timeline" aria-hidden="true">
        <span class="notch__dot"></span>
      </div>

      {title && <Heading class="notch__title">{title}</Heading>}
      {description && <p class="notch__desc">{description}</p>}

      {
        href && action && (
          <a class="notch__action t-label" href={href}>
            <bdi lang="en" aria-hidden="true">{sign}</bdi> {action}
            {title && <span class="visually-hidden">— {title}</span>}
          </a>
        )
      }
      {!href && action && <span class="notch__action t-label"><bdi lang="en" aria-hidden="true">{sign}</bdi> {action}</span>}
    </div>
  </div>
</article>

<style>
  @layer components {
    .notch {
      container-type: inline-size;
      min-inline-size: 0;
    }

    .notch__card {
      --pad: var(--notch-card-pad);
      /* notch centre: top padding + media height + gap */
      --ny: calc(
        var(--pad) + (100cqi - 2 * var(--pad)) * var(--notch-media-ratio) + var(--notch-gap)
      );
      --ntop: calc(var(--ny) - var(--notch-h) / 2);
      /* the pill is centred on the edge: half its length cuts into the card */
      --nrect: calc(var(--notch-w) / 2 - var(--notch-h) / 2);
      --nround: calc(var(--nrect) - var(--notch-h) / 2);

      position: relative;
      display: grid;
      gap: calc(2 * var(--notch-gap));
      padding: var(--pad);
      background: var(--color-notch-card);
      color: var(--color-notch-ink);
      border-radius: var(--radius-card);

      /* mask = full card − (left rect + left round end + right rect + right round end) */
      -webkit-mask-image:
        linear-gradient(black, black),
        linear-gradient(black, black),
        radial-gradient(circle closest-side, black 92%, transparent 100%),
        linear-gradient(black, black),
        radial-gradient(circle closest-side, black 92%, transparent 100%);
      mask-image:
        linear-gradient(black, black),
        linear-gradient(black, black),
        radial-gradient(circle closest-side, black 92%, transparent 100%),
        linear-gradient(black, black),
        radial-gradient(circle closest-side, black 92%, transparent 100%);
      -webkit-mask-size:
        100% 100%,
        var(--nrect) var(--notch-h),
        var(--notch-h) var(--notch-h),
        var(--nrect) var(--notch-h),
        var(--notch-h) var(--notch-h);
      mask-size:
        100% 100%,
        var(--nrect) var(--notch-h),
        var(--notch-h) var(--notch-h),
        var(--nrect) var(--notch-h),
        var(--notch-h) var(--notch-h);
      -webkit-mask-position:
        0 0,
        left 0 top var(--ntop),
        left var(--nround) top var(--ntop),
        right 0 top var(--ntop),
        right var(--nround) top var(--ntop);
      mask-position:
        0 0,
        left 0 top var(--ntop),
        left var(--nround) top var(--ntop),
        right 0 top var(--ntop),
        right var(--nround) top var(--ntop);
      -webkit-mask-repeat: no-repeat;
      mask-repeat: no-repeat;
      -webkit-mask-composite: source-out, source-over, source-over, source-over;
      mask-composite: subtract, add, add, add;
    }

    .notch__media {
      position: relative;
      aspect-ratio: 1 / var(--notch-media-ratio);
      overflow: hidden;
      background: var(--color-media);
      border-radius: calc(var(--radius-card) - var(--pad));
    }

    .notch__media :global(picture),
    .notch__media :global(img) {
      display: block;
      inline-size: 100%;
      block-size: 100%;
      object-fit: cover;
    }

    .notch__body {
      display: grid;
      gap: var(--space-sm);
      padding-inline: var(--space-2xs);
      padding-block-end: var(--space-2xs);
    }

    .notch__row {
      display: flex;
      justify-content: space-between;
      gap: var(--space-sm);
    }

    .notch__label,
    .notch__meta {
      color: var(--color-notch-label);
    }

    .notch__label {
      color: var(--color-notch-ink);
    }

    .notch__timeline {
      position: relative;
      block-size: var(--notch-dot);
    }

    .notch__timeline::before {
      content: '';
      position: absolute;
      inset-inline: 0;
      inset-block-start: calc(50% - var(--line-width) / 2);
      block-size: var(--line-width);
      background: var(--color-notch-line);
    }

    .notch__dot {
      position: absolute;
      inset-block-start: 0;
      inset-inline-start: calc(var(--notch-progress) * (100% - var(--notch-dot)));
      inline-size: var(--notch-dot);
      block-size: var(--notch-dot);
      border-radius: var(--radius-pill);
      background: var(--color-notch-ink);
    }

    .notch__title {
      font-size: var(--text-md);
      line-height: var(--leading-snug);
    }

    .notch__desc {
      font-size: var(--text-sm);
      line-height: var(--leading-snug);
      color: var(--color-notch-label);
    }

    .notch__action {
      justify-self: start;
      color: var(--color-notch-ink);
      text-decoration: none;
      padding-block: var(--space-2xs);
    }

    /* Stretched link: the whole card is clickable, the action stays the label. */
    a.notch__action::after {
      content: '';
      position: absolute;
      inset: 0;
    }

    a.notch__action:focus-visible {
      outline: none;
    }

    .notch__card:has(a.notch__action:focus-visible) {
      outline: var(--line-width-strong) solid var(--color-focus);
      outline-offset: calc(-1 * var(--line-width-strong) * 3);
    }

    .notch__card:has(a.notch__action:hover) .notch__dot {
      background: var(--color-accent);
    }
  }
</style>
