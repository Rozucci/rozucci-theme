---
/**
 * /styleguide — living style guide (noindex, not in the nav).
 *
 * Every token list below is parsed from the token/theme CSS at build time, so
 * the guide can never drift from the source. Colour values are read from the
 * browser at runtime, so they always show the active theme and mode.
 *
 * This page is a developer tool: its copy is English and inline by design.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import CellGrid from '../components/CellGrid.astro';
import Label from '../components/Label.astro';
import TextLink from '../components/TextLink.astro';
import SectionHead from '../components/SectionHead.astro';
import MediaFrame from '../components/MediaFrame.astro';
import ProjectCard from '../components/ProjectCard.astro';
import NotchCard from '../components/NotchCard.astro';
import NotchRow from '../components/NotchRow.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Arrow from '../components/Arrow.astro';
import Button from '../components/Button.astro';
import Price from '../components/Price.astro';
import VariantPicker from '../components/VariantPicker.astro';
import Quantity from '../components/Quantity.astro';
import Accordion from '../components/Accordion.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ProductCard from '../components/ProductCard.astro';
import ThemeSwitcher from '../components/ThemeSwitcher.astro';
import productPrint from '../assets/placeholders/product-print-main.png';
import productSound from '../assets/placeholders/product-sound-main.png';
import productPreset from '../assets/placeholders/product-preset-main.png';
import cover1 from '../assets/placeholders/orbit-field-cover.png';
import cover2 from '../assets/placeholders/index-of-nights-cover.png';
import cover3 from '../assets/placeholders/event-horizon-cover.png';
import wide1 from '../assets/placeholders/frame-arrives-wide.png';
import detail1 from '../assets/placeholders/low-frequency-detail.png';
import detail2 from '../assets/placeholders/second-mind-detail.png';
import semanticCss from '../styles/tokens/semantic.css?raw';
import ivoryCss from '../styles/themes/ivory.css?raw';
import { site } from '../site.config';
import { indexSign } from '../i18n/utils';

const rootBlock = semanticCss.split(/\n\s*:root\[data-mode/)[0] ?? semanticCss;
const names = (src: string, prefix: string) =>
  [...new Set([...src.matchAll(new RegExp(`(--${prefix}[a-z0-9-]*)\\s*:`, 'g'))].map((m) => m[1]!))];

const colorRoles = names(ivoryCss, 'color-');
const textTokens = names(rootBlock, 'text-');
const spaceTokens = names(rootBlock, 'space-').filter((n) => n !== '--space-0');
const durTokens = names(rootBlock, 'dur-');
const easeTokens = names(rootBlock, 'ease-');
const ratioTokens = names(rootBlock, 'ratio-');
const fontTokens = names(rootBlock, 'font-');
const shapeTokens = [
  ...names(rootBlock, 'line-width'),
  ...names(rootBlock, 'radius'),
  ...names(rootBlock, 'notch-'),
];

const sections = [
  { id: 'colour', title: 'Colour roles' },
  { id: 'type', title: 'Type' },
  { id: 'space', title: 'Space' },
  { id: 'shape', title: 'Lines, radius, ratios' },
  { id: 'motion-tokens', title: 'Motion tokens' },
  { id: 'accent', title: 'Accent proof' },
  { id: 'grid', title: 'CellGrid' },
  { id: 'components', title: 'Components' },
  { id: 'notch', title: 'NotchCard' },
  { id: 'themes', title: 'Themes' },
  { id: 'store', title: 'Store kit' },
  { id: 'motion', title: 'Motion' },
];

const themeNotes: Record<string, string> = {
  ivory: 'Warm canvas, clay accent, collapsed grid.',
  bone: 'Stone ground, bone cards, olive glass.',
  stone: 'Boxed page on a stone ground, uppercase sans.',
  sand: 'Boxed cells with gaps, dark hairlines, uppercase serif.',
  paper: 'Teal ink, coral accent, italic emphasis.',
  studio: 'Monochrome greige, outline buttons, grey media.',
  sage: 'Green ground, black lines, all monospace.',
};
---

<BaseLayout locale="en" title="Style guide" noindex dir="ltr">
  <div class="sg" data-sg>
    <section class="section section--flush pad sg-head">
      <p class="t-label u-muted">Rozucci theme · living style guide</p>
      <h1 class="t-3xl">Style guide</h1>
      <p class="measure u-muted">
        Every value on this page is read from the token files. Switch theme, mode or direction and
        the whole site follows. Edit <code>src/styles/themes/ivory.css</code> → <code>--color-accent</code>
        to see one change travel everywhere.
      </p>

      <div class="sg-controls" role="group" aria-label="Preview controls">
        <div class="sg-control">
          <span class="t-label u-muted">Theme</span>
          <div class="cluster sg-buttons">
            {
              site.themes.map((name) => (
                <button type="button" class="t-label sg-btn" data-set-theme={name} aria-pressed="false">
                  [ {name} ]
                </button>
              ))
            }
          </div>
        </div>
        <div class="sg-control">
          <span class="t-label u-muted">Mode</span>
          <div class="cluster sg-buttons">
            {
              ['auto', 'light', 'dark'].map((m) => (
                <button type="button" class="t-label sg-btn" data-set-mode={m} aria-pressed="false">
                  [ {m} ]
                </button>
              ))
            }
          </div>
        </div>
        <div class="sg-control">
          <span class="t-label u-muted">Direction</span>
          <div class="cluster sg-buttons">
            <button type="button" class="t-label sg-btn" data-set-dir="ltr" aria-pressed="true">[ LTR · en ]</button>
            <button type="button" class="t-label sg-btn" data-set-dir="rtl" aria-pressed="false">[ RTL · fa ]</button>
          </div>
        </div>
      </div>

      <nav class="sg-toc" aria-label="Style guide sections">
        <ol role="list" class="cluster">
          {
            sections.map((s, i) => (
              <li>
                <a class="t-label" href={`#${s.id}`}>
                  {indexSign(i + 1)} {s.title}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </section>

    <div class="sg-preview" data-sg-preview>
      <section class="section" id="colour" aria-labelledby="colour-title">
        <header class="pad sg-section-head">
          <span class="t-label u-muted">{indexSign(1)}</span>
          <h2 id="colour-title" class="t-xl">Colour roles</h2>
        </header>
        <ul role="list" class="sg-swatches">
          {
            colorRoles.map((role) => (
              <li class="sg-swatch">
                <span class="sg-chip" style={`background: var(${role})`} data-swatch />
                <code class="t-label">{role}</code>
                <span class="t-label u-muted" data-swatch-value>
                  —
                </span>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="section" id="type" aria-labelledby="type-title">
        <header class="pad sg-section-head">
          <span class="t-label u-muted">{indexSign(2)}</span>
          <h2 id="type-title" class="t-xl">Type</h2>
        </header>
        <ul role="list" class="sg-rows">
          {
            fontTokens.map((token) => (
              <li class="sg-row">
                <code class="t-label">{token}</code>
                <span class="sg-font-sample" style={`font-family: var(${token})`}>
                  Rozucci 0123 — رزوچی ۰۱۲۳
                </span>
              </li>
            ))
          }
          {
            [...textTokens].reverse().map((token) => (
              <li class="sg-row">
                <code class="t-label">{token}</code>
                <span
                  class="sg-type-sample"
                  style={`font-size: var(${token}); font-family: ${
                    token === '--text-2xs' || token === '--text-xs' ? 'var(--font-mono)' : 'var(--font-display)'
                  }`}
                >
                  Image, motion, code
                </span>
              </li>
            ))
          }
          <li class="sg-row">
            <code class="t-label">.t-label</code>
            <span class="t-label">[+] Add to cart · (01) · /work · 2026</span>
          </li>
          <li class="sg-row" lang="fa" dir="rtl">
            <code class="t-label" lang="en" dir="ltr">.t-label (fa)</code>
            <span class="t-label">[+] افزودن · (01) · <bdi>/work</bdi> · ۱۴۰۵</span>
          </li>
          <li class="sg-row">
            <code class="t-label">body</code>
            <p class="measure">
              Rozucci is a one-person studio. Ideas arrive from physics, cosmology and night-time
              silence; they leave as images, films, websites and systems.
            </p>
          </li>
          <li class="sg-row" lang="fa" dir="rtl">
            <code class="t-label" lang="en" dir="ltr">body (fa)</code>
            <p class="measure">
              رزوچی یک استودیوی یک‌نفره است. ایده‌ها از فیزیک، کیهان‌شناسی و سکوتِ شب می‌آیند و به شکل
              تصویر، فیلم، وب‌سایت و سیستم بیرون می‌روند.
            </p>
          </li>
        </ul>
      </section>

      <section class="section" id="space" aria-labelledby="space-title">
        <header class="pad sg-section-head">
          <span class="t-label u-muted">{indexSign(3)}</span>
          <h2 id="space-title" class="t-xl">Space</h2>
        </header>
        <ul role="list" class="sg-rows">
          {
            spaceTokens.map((token) => (
              <li class="sg-row">
                <code class="t-label">{token}</code>
                <span class="sg-bar" style={`inline-size: var(${token})`} />
              </li>
            ))
          }
        </ul>
      </section>

      <section class="section" id="shape" aria-labelledby="shape-title">
        <header class="pad sg-section-head">
          <span class="t-label u-muted">{indexSign(4)}</span>
          <h2 id="shape-title" class="t-xl">Lines, radius, ratios</h2>
        </header>
        <ul role="list" class="sg-rows">
          {
            shapeTokens.map((token) => (
              <li class="sg-row">
                <code class="t-label">{token}</code>
                <span class="t-label u-muted" data-token-value={token}>
                  —
                </span>
              </li>
            ))
          }
        </ul>
        <ul role="list" class="sg-ratios pad">
          {
            ratioTokens.map((token) => (
              <li class="stack stack-sm">
                <span class="sg-ratio" style={`aspect-ratio: var(${token})`} />
                <code class="t-label">{token}</code>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="section" id="motion-tokens" aria-labelledby="motion-title">
        <header class="pad sg-section-head">
          <span class="t-label u-muted">{indexSign(5)}</span>
          <h2 id="motion-title" class="t-xl">Motion tokens</h2>
        </header>
        <ul role="list" class="sg-rows">
          {
            [...durTokens, ...easeTokens].map((token) => (
              <li class="sg-row">
                <code class="t-label">{token}</code>
                <span class="t-label u-muted" data-token-value={token}>
                  —
                </span>
              </li>
            ))
          }
        </ul>
      </section>


      <section class="section" id="accent" aria-labelledby="accent-title">
        <header class="pad sg-section-head">
          <span class="t-label u-muted">{indexSign(6)}</span>
          <h2 id="accent-title" class="t-xl">Accent proof</h2>
        </header>
        <div class="pad sg-accent">
          <p class="measure">
            Every element below reads <code>--color-accent</code> (or its text-safe pair
            <code>--color-accent-ink</code>). Pick a colour to preview it site-wide for this page
            view. To make it permanent, change the <code>--color-accent</code> line in
            <code>src/styles/themes/ivory.css</code> — one line, every page.
          </p>
          <div class="cluster">
            <label class="t-label sg-picker">
              <span>Preview --color-accent</span>
              <input type="color" value="#d97757" data-accent-picker />
            </label>
            <button type="button" class="t-label sg-btn" data-accent-reset>[ reset ]</button>
          </div>
          <CellGrid cols={4} colsSm={2} frame>
            <div class="pad-cell stack stack-sm">
              <Label>Fill</Label>
              <span class="sg-accent-fill" />
            </div>
            <div class="pad-cell stack stack-sm">
              <Label>Text (accent-ink)</Label>
              <span class="u-accent t-lg">Accent text</span>
            </div>
            <div class="pad-cell stack stack-sm">
              <Label>Focus ring</Label>
              <button type="button" class="t-label sg-btn sg-focus-demo">[ focused ]</button>
            </div>
            <div class="pad-cell stack stack-sm">
              <Label>Checkbox / form accent</Label>
              <label class="cluster t-label"><input type="checkbox" checked class="sg-accent-check" /> done</label>
            </div>
          </CellGrid>
        </div>
      </section>

      <section class="section" id="grid" aria-labelledby="grid-title">
        <header class="pad sg-section-head">
          <span class="t-label u-muted">{indexSign(7)}</span>
          <h2 id="grid-title" class="t-xl">CellGrid</h2>
        </header>
        <div class="pad stack stack-lg sg-demo">
          <p class="measure u-muted">
            Collapsed lines, never doubled — including an incomplete last row. Fixed columns
            (4 → 2 → 1) and auto-fill.
          </p>
          <CellGrid cols={4} frame>
            {Array.from({ length: 7 }, (_, i) => (
              <div class="pad-cell sg-cell">
                <Label index={i + 1}>Cell</Label>
              </div>
            ))}
          </CellGrid>
          <CellGrid min="12rem">
            {Array.from({ length: 5 }, (_, i) => (
              <div class="pad-cell sg-cell">
                <Label>auto-fill · {i + 1}</Label>
              </div>
            ))}
          </CellGrid>
        </div>
      </section>

      <section class="section" id="components" aria-labelledby="components-title">
        <header class="pad sg-section-head">
          <span class="t-label u-muted">{indexSign(8)}</span>
          <h2 id="components-title" class="t-xl">Components</h2>
        </header>
        <CellGrid cols={3}>
          <div class="pad-cell stack">
            <Label tone="ink">Label</Label>
            <Label>Muted label</Label>
            <Label bracket tone="ink">Bracket</Label>
            <Label index={3} tone="ink">Indexed</Label>
            <Label code tone="accent">W07 · 02:40</Label>
          </div>
          <div class="pad-cell stack">
            <Label tone="ink">TextLink</Label>
            <TextLink href="#components">All work</TextLink>
            <TextLink href="#components" arrow="back">Back</TextLink>
            <TextLink href="#components" sign="[+]">Add to cart</TextLink>
            <TextLink href="#components" variant="label" arrow={false}>/work</TextLink>
            <TextLink href="https://example.com" externalNote="opens in a new tab">External</TextLink>
          </div>
          <div class="pad-cell stack">
            <Label tone="ink">Header tools</Label>
            <LanguageSwitcher locale="en" long />
            <ThemeToggle locale="en" />
            <p class="t-label u-muted">Arrows mirror in RTL: <Arrow /> <Arrow direction="back" /></p>
          </div>
        </CellGrid>
        <div class="section">
          <SectionHead index={2} title="SectionHead with a lead" lead="A short lead sits under the title in the content column. The index stays Latin in both languages.">
            <TextLink slot="action" href="#components" variant="label">View all</TextLink>
          </SectionHead>
        </div>
        <div class="section pad sg-demo">
          <CellGrid cols={3} frame>
            <div class="pad-cell"><MediaFrame src={detail1} alt="" ratio="square" caption="ratio square · 1:1" sizes="33vw" /></div>
            <div class="pad-cell"><MediaFrame src={cover1} alt="" ratio="portrait" caption="ratio portrait · 4:5" sizes="33vw" /></div>
            <div class="pad-cell"><MediaFrame src={wide1} alt="" ratio="landscape" caption="ratio landscape · 3:2" sizes="33vw" /></div>
          </CellGrid>
        </div>
        <div class="section">
          <CellGrid cols={3} as="ul">
            <ProjectCard href="#components" title="Orbit Field" summary="Generative orbits in a single hairline system." discipline="creative-coding" year={2026} index={4} cover={cover1} coverAlt="" locale="en" />
            <ProjectCard href="#components" title="Index of Nights" discipline="web" year={2025} index={3} cover={cover2} coverAlt="" locale="en" />
            <ProjectCard href="#components" title="Event Horizon Studies" discipline="visual-art" year={2025} index={1} cover={cover3} coverAlt="" locale="en" />
          </CellGrid>
        </div>
      </section>

      <section class="section" id="notch" aria-labelledby="notch-title">
        <header class="pad sg-section-head">
          <span class="t-label u-muted">{indexSign(9)}</span>
          <h2 id="notch-title" class="t-xl">NotchCard</h2>
        </header>
        <p class="pad measure u-muted sg-note">
          The only rounded element. Notches are a CSS mask — the ground shows through. Size and
          position: <code>--notch-w</code>, <code>--notch-h</code>, <code>--notch-gap</code>,
          <code>--notch-media-ratio</code>. Toggle RTL above to see the mirror.
        </p>
        <NotchRow label="NotchCard examples">
          <NotchCard label="Visual art" meta="06 WORKS" title="Event horizon studies" description="Acrylic and digital studies of light at the edge." href="#notch" action="View" progress={0.15} src={detail2} />
          <NotchCard label="Music" meta="02:40" title="Low frequency garden" description="Sound for an installation, in one long breath." href="#notch" action="Add to cart" progress={0.5} src={detail1} />
          <NotchCard label="Phase 02" meta="W05–W08" title="Build" description="Media slot with custom content instead of an image." href="#notch" action="View" progress={0.85}>
            <span slot="media" class="sg-notch-media t-3xl"><bdi lang="en">02</bdi></span>
          </NotchCard>
        </NotchRow>
      </section>

      <section class="section" id="themes" aria-labelledby="themes-title">
        <header class="pad sg-section-head">
          <span class="t-label u-muted">{indexSign(10)}</span>
          <h2 id="themes-title" class="t-xl">Themes</h2>
        </header>
        <p class="pad measure u-muted sg-note">
          Each preview below is the same markup inside <code>&lt;div data-theme="…"&gt;</code>. A theme
          file remaps colour roles and a few customisation knobs (frame inset, boxed grid, display
          face and case, emphasis, media filter, button style). Switch the whole site with the
          footer's <code>[ theme ]</code> button or the controls at the top.
        </p>
        <div class="sg-themes pad">
          {
            site.themes.map((name) => (
              <div class="sg-theme" data-theme={name}>
                <div class="sg-theme__inner">
                  <div class="cluster cluster--between">
                    <Label tone="ink" code>{name}</Label>
                    <span class="sg-theme__swatches" aria-hidden="true">
                      <span style="background: var(--color-canvas)" />
                      <span style="background: var(--color-surface)" />
                      <span style="background: var(--color-line)" />
                      <span style="background: var(--color-ink)" />
                      <span style="background: var(--color-accent)" />
                    </span>
                  </div>
                  <p class="t-xl">Image, <em>motion</em>, code</p>
                  <p class="u-muted sg-theme__note">{themeNotes[name]}</p>
                  <CellGrid cols={2} colsSm={2}>
                    <div class="pad-cell"><Label>Cell</Label></div>
                    <div class="pad-cell"><Price value={45} locale="en" /></div>
                  </CellGrid>
                  <div class="cluster">
                    <Button sign="[+]">Add</Button>
                    <Button variant="secondary">View</Button>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
        <div class="pad sg-demo"><ThemeSwitcher locale="en" /></div>
      </section>

      <section class="section" id="store" aria-labelledby="store-title">
        <header class="pad sg-section-head">
          <span class="t-label u-muted">{indexSign(11)}</span>
          <h2 id="store-title" class="t-xl">Store kit</h2>
        </header>
        <div class="pad sg-demo stack stack-lg">
          <Breadcrumb label="Breadcrumb" items={[{ label: 'Shop', href: '#store' }, { label: 'Prints', href: '#store' }, { label: 'Event Horizon' }]} />
          <div class="cluster">
            <Button sign="[+]">Add to cart</Button>
            <Button variant="secondary" arrow>View cart</Button>
            <Button variant="ghost">Ghost</Button>
            <Button disabled>Disabled</Button>
          </div>
          <div class="cluster">
            <Price value={45} locale="en" size="md" />
            <Price value={29} from locale="en" />
            <Quantity label="Quantity" decrease="Decrease" increase="Increase" id="sg-qty" />
          </div>
          <VariantPicker legend="Size" name="sg-variant" basePrice={45} options={[{ id: 'a3', label: 'A3', price: 45 }, { id: 'a2', label: 'A2', price: 65 }, { id: 'a1', label: 'A1', price: 95 }]} />
          <div class="measure">
            <Accordion title="Details" open><p>Pigment inks on 310 g cotton rag. Native details/summary — no JS.</p></Accordion>
            <Accordion title="Shipping and returns"><p>Ships rolled in a tube.</p></Accordion>
          </div>
        </div>
        <CellGrid cols={3} as="ul">
          <ProductCard slug="sg-print" href="#store" title="Event Horizon — Giclée print" category="print" price={45} fromPrice image={productPrint} alt="" locale="en" variant="a3" />
          <ProductCard slug="sg-sound" href="#store" title="Low Frequency Garden — Album" category="sound" price={12} fromPrice image={productSound} alt="" locale="en" variant="digital" />
          <ProductCard slug="sg-preset" href="#store" title="Night Grade — 12 LUTs" category="preset" price={29} digital image={productPreset} alt="" locale="en" variant="personal" />
        </CellGrid>
      </section>

      <section class="section" id="motion" aria-labelledby="motion-demo-title">
        <header class="pad sg-section-head">
          <span class="t-label u-muted">{indexSign(12)}</span>
          <h2 id="motion-demo-title" class="t-xl">Motion</h2>
        </header>
        <div class="pad sg-demo stack stack-lg" data-motion-demo>
          <p class="measure u-muted">
            Calm and mechanical: <code>--ease-out</code> (expo.out) and <code>--ease-standard</code>
            (power3.out), durations from <code>--dur-*</code>. Every move below plays on scroll; the
            button replays them. Flags live in <code>src/site.config.ts → motion</code>; reduced
            motion disables all of them.
          </p>
          <div class="cluster">
            <button type="button" class="t-label sg-btn" data-motion-replay>[ replay ]</button>
            <span class="t-label u-muted" data-motion-state></span>
          </div>
          <CellGrid cols={3} frame>
            <div class="pad-cell stack">
              <Label>(a) Hairline draw</Label>
              <span class="sg-rule" data-demo="draw" />
            </div>
            <div class="pad-cell stack">
              <Label>(b) Lines — en</Label>
              <p class="t-lg" data-demo="lines">Image, motion and code — one practice, built alone.</p>
            </div>
            <div class="pad-cell stack" lang="fa" dir="rtl">
              <Label>(c) Lines — fa (never chars)</Label>
              <p class="t-lg" data-demo="lines">تصویر، حرکت و کد — یک تمرین، تنها ساخته‌شده.</p>
            </div>
            <div class="pad-cell stack">
              <Label>(d) Media wipe + settle</Label>
              <MediaFrame src={detail2} alt="" ratio="square" sizes="33vw" reveal={false} class="sg-media-demo" />
            </div>
            <div class="pad-cell stack">
              <Label>(e) Rise (batched)</Label>
              <div class="stack stack-sm">
                <span class="t-label" data-demo="up">[ 01 ] first</span>
                <span class="t-label" data-demo="up">[ 02 ] second</span>
                <span class="t-label" data-demo="up">[ 03 ] third</span>
              </div>
            </div>
            <div class="pad-cell stack">
              <Label>(f) Cursor label</Label>
              <a href="#motion" class="sg-cursor-demo t-label" data-cursor="view">Hover me (desktop)</a>
            </div>
          </CellGrid>
        </div>
      </section>

      <slot />
    </div>
  </div>
</BaseLayout>

