<script>
  /* Style guide controls + live token values. Re-binds after view transitions. */
  function toHex(rgb: string): string {
    const m = rgb.match(/[\d.]+/g);
    if (!m || m.length < 3) return rgb;
    const [r, g, b, a] = m.map(Number);
    const hex = '#' + [r, g, b].map((v) => Math.round(v!).toString(16).padStart(2, '0')).join('');
    return a !== undefined && a < 1 ? `${hex} · α${a}` : hex;
  }

  function store(key: string, value: string | null) {
    try {
      if (value === null) localStorage.removeItem(key);
      else localStorage.setItem(key, value);
    } catch {
      /* storage unavailable — choice lasts for this page view only */
    }
  }

  function init() {
    const root = document.querySelector<HTMLElement>('[data-sg]');
    if (!root) return;
    const html = document.documentElement;
    const preview = root.querySelector<HTMLElement>('[data-sg-preview]');

    const refresh = () => {
      root.querySelectorAll<HTMLElement>('[data-swatch]').forEach((chip) => {
        const out = chip.parentElement?.querySelector('[data-swatch-value]');
        if (out) out.textContent = toHex(getComputedStyle(chip).backgroundColor);
      });
      const cs = getComputedStyle(html);
      root.querySelectorAll<HTMLElement>('[data-token-value]').forEach((el) => {
        el.textContent = cs.getPropertyValue(el.dataset.tokenValue!).trim() || '—';
      });
      const theme = html.dataset.theme;
      const mode = html.dataset.mode ?? 'auto';
      root.querySelectorAll<HTMLButtonElement>('[data-set-theme]').forEach((b) => {
        b.setAttribute('aria-pressed', String(b.dataset.setTheme === theme));
      });
      root.querySelectorAll<HTMLButtonElement>('[data-set-mode]').forEach((b) => {
        b.setAttribute('aria-pressed', String(b.dataset.setMode === mode));
      });
      const dir = preview?.getAttribute('dir') ?? 'ltr';
      root.querySelectorAll<HTMLButtonElement>('[data-set-dir]').forEach((b) => {
        b.setAttribute('aria-pressed', String(b.dataset.setDir === dir));
      });
    };

    root.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement).closest<HTMLButtonElement>('button');
      if (!target) return;
      if (target.dataset.setTheme) {
        html.dataset.theme = target.dataset.setTheme;
        store('rz-theme', target.dataset.setTheme);
      } else if (target.dataset.setMode) {
        const m = target.dataset.setMode;
        if (m === 'auto') html.removeAttribute('data-mode');
        else html.dataset.mode = m;
        store('rz-mode', m === 'auto' ? null : m);
        document.dispatchEvent(new CustomEvent('rz:mode-change'));
      } else if (target.dataset.setDir && preview) {
        const rtl = target.dataset.setDir === 'rtl';
        preview.setAttribute('dir', rtl ? 'rtl' : 'ltr');
        preview.setAttribute('lang', rtl ? 'fa' : 'en');
      } else {
        return;
      }
      requestAnimationFrame(refresh);
    });

    const picker = root.querySelector<HTMLInputElement>('[data-accent-picker]');
    picker?.addEventListener('input', () => {
      html.style.setProperty('--color-accent', picker.value);
      requestAnimationFrame(refresh);
    });
    root.querySelector('[data-accent-reset]')?.addEventListener('click', () => {
      html.style.removeProperty('--color-accent');
      if (picker) picker.value = '#d97757';
      requestAnimationFrame(refresh);
    });

    const observer = new MutationObserver(() => requestAnimationFrame(refresh));
    observer.observe(html, { attributes: true, attributeFilter: ['data-theme', 'data-mode'] });
    const mq = window.matchMedia('(prefers-color-scheme: dark)');
    mq.addEventListener('change', refresh);
    document.addEventListener(
      'astro:before-swap',
      () => {
        observer.disconnect();
        mq.removeEventListener('change', refresh);
        html.style.removeProperty('--color-accent');
      },
      { once: true },
    );
    refresh();
  }

  if (document.querySelector('meta[name="astro-view-transitions-enabled"]')) {
    document.addEventListener('astro:page-load', init);
  } else {
    init();
  }
</script>

<script>
  /* Motion demos: replayable versions of the site's signature moves. */
  import { gsap } from 'gsap';
  import { SplitText } from 'gsap/SplitText';
  import { motion } from '../motion/config';
  import { onPageLoad } from '../scripts/lifecycle';

  gsap.registerPlugin(SplitText);

  onPageLoad(() => {
    const root = document.querySelector<HTMLElement>('[data-motion-demo]');
    if (!root) return;
    const state = root.querySelector('[data-motion-state]');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (state) state.textContent = reduce ? 'reduced motion: demos are static' : '';
    const splits = [...root.querySelectorAll<HTMLElement>('[data-demo="lines"]')].map((el) =>
      SplitText.create(el, { type: 'lines', mask: 'lines', linesClass: 'rz-line' }),
    );

    const play = () => {
      if (reduce) return;
      const out = motion.ease('out');
      const tl = gsap.timeline();
      tl.fromTo(root.querySelectorAll('[data-demo="draw"]'), { scaleX: 0 }, { scaleX: 1, duration: motion.dur('slower'), ease: out }, 0);
      splits.forEach((s) =>
        tl.fromTo(s.lines, { yPercent: 110 }, { yPercent: 0, duration: motion.dur('slow'), ease: out, stagger: motion.stagger() * 1.5 }, 0.1),
      );
      const frame = root.querySelector('.sg-media-demo .media__frame');
      const img = root.querySelector('.sg-media-demo img');
      if (frame) tl.fromTo(frame, { clipPath: 'inset(100% 0% 0% 0%)' }, { clipPath: 'inset(0% 0% 0% 0%)', duration: motion.dur('slow'), ease: out }, 0.15);
      if (img) tl.fromTo(img, { scale: motion.settleScale() }, { scale: 1, duration: motion.dur('slower'), ease: out }, 0.15);
      tl.fromTo(root.querySelectorAll('[data-demo="up"]'), { opacity: 0, y: motion.px('distance') }, { opacity: 1, y: 0, duration: motion.dur('slow'), ease: out, stagger: motion.stagger() }, 0.2);
    };

    root.querySelector('[data-motion-replay]')?.addEventListener('click', play);
    document.addEventListener('astro:before-swap', () => splits.forEach((s) => s.revert()), { once: true });
  });
</script>
