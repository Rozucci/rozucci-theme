---
/**
 * Work index — every project in one CellGrid, filterable by discipline.
 * Filtering is progressive: without JS every project is listed; with JS the
 * filter bar appears and changes animate with GSAP Flip (when motion is on).
 * `?d=<discipline>` preselects a filter (used by the home page links).
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CellGrid from '../../../components/CellGrid.astro';
import SectionHead from '../../../components/SectionHead.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import type { LocaleCode } from '../../../site.config';
import { code, localeStaticPaths, num, useTranslations } from '../../../i18n/utils';
import { DISCIPLINES } from '../../../data/disciplines';
import { getProjects, projectHref } from '../../../lib/projects';

export function getStaticPaths() {
  return localeStaticPaths();
}

interface Props {
  locale: LocaleCode;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const projects = await getProjects(locale);
const count = (d?: string) => (d ? projects.filter((p) => p.data.discipline === d).length : projects.length);
const filters = [{ key: 'all', name: t.actions.all, n: count() }].concat(
  DISCIPLINES.filter((d) => count(d) > 0).map((d) => ({ key: d, name: t.disciplines[d].name, n: count(d) })),
);
---

<BaseLayout locale={locale} title={t.work.title} description={t.work.intro}>
  <section class="section section--flush" aria-labelledby="work-title">
    <SectionHead index={1} id="work-title" level="h1" size="2xl" title={t.work.title} lead={t.work.intro} />

    <div class="work-filters pad u-js-only" role="group" aria-label={t.work.filterLabel} data-work-filters>
      {
        filters.map((f, i) => (
          <button type="button" class="work-filter t-label" data-filter={f.key} aria-pressed={i === 0 ? 'true' : 'false'}>
            <span class="work-filter__name">{f.name}</span>&nbsp;<bdi lang="en" class="work-filter__n">({code(f.n)})</bdi>
          </button>
        ))
      }
    </div>
    <p class="visually-hidden" aria-live="polite" data-work-status data-label={t.work.count} data-lang={locale}>
      {num(projects.length, locale)} {t.work.count}
    </p>

    <CellGrid cols={3} as="ul" data-work-grid>
      {
        projects.map((p, i) => (
          <ProjectCard
            href={projectHref(p)}
            title={p.data.title}
            summary={p.data.summary}
            discipline={p.data.discipline}
            year={p.data.year}
            index={p.data.order}
            cover={p.data.cover}
            coverAlt={p.data.coverAlt}
            locale={locale}
            priority={i < 3}
          />
        ))
      }
    </CellGrid>
    {projects.length === 0 && <p class="pad u-muted">{t.work.empty}</p>}
  </section>
</BaseLayout>

<style>
  @layer components {
    .work-filters {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-xs) var(--space-lg);
      padding-block: var(--space-md);
      border-block-start: var(--line-width) solid var(--color-line);
      border-block-end: var(--line-width) solid var(--color-line);
    }

    .work-filter {
      display: inline-flex;
      align-items: center;
      min-block-size: var(--hit-target);
      color: var(--color-ink-muted);
      transition: color var(--dur-hover) var(--ease-standard);
    }

    .work-filter::before {
      content: '[\00a0';
      visibility: hidden;
    }

    .work-filter::after {
      content: '\00a0]';
      visibility: hidden;
    }

    .work-filter:hover,
    .work-filter[aria-pressed='true'] {
      color: var(--color-ink);
    }

    .work-filter[aria-pressed='true']::before,
    .work-filter[aria-pressed='true']::after {
      visibility: visible;
    }

    .work-filter__n {
      color: var(--color-ink-muted);
    }

    /* Filtered-out cells. A class (not [hidden]) so Flip can animate them out. */
    :global(.is-out) {
      display: none;
    }
  }
</style>

<script>
  import { initWorkFilter } from '../../../scripts/work-filter';
  import { onPageLoad } from '../../../scripts/lifecycle';
  onPageLoad(initWorkFilter);
</script>
